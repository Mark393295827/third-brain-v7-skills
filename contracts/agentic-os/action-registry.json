{
  "schema_version": "1.0",
  "actions": [
    {
      "id": "skill-lint",
      "label": {"en": "Lint skills", "zh": "技能契约检查"},
      "description": {"en": "Validate every repository skill contract.", "zh": "验证仓库内全部技能契约。"},
      "capability": "verify",
      "state": "LIVE",
      "effect": "READ_ONLY",
      "approval_required": false,
      "command": ["{python}", "tools/lint-agent-skills.py"],
      "timeout_seconds": 30,
      "verifier": ["{python}", "tools/lint-agent-skills.py"],
      "receipt_policy": "required",
      "loop_contract": null
    },
    {
      "id": "runtime-envelope-verify",
      "label": {"en": "Verify runtime envelope", "zh": "验证运行时信封"},
      "description": {"en": "Run the strict checked-in runtime-envelope verifier.", "zh": "运行仓库内置的严格运行时信封验证器。"},
      "capability": "verify",
      "state": "LIVE",
      "effect": "READ_ONLY",
      "approval_required": false,
      "command": ["{python}", "skills/harness-engineering/scripts/validate_runtime_envelope.py", "contracts/runtime/obsidian-pipeline-envelope.json", "--strict"],
      "timeout_seconds": 30,
      "verifier": ["{python}", "skills/harness-engineering/scripts/validate_runtime_envelope.py", "contracts/runtime/obsidian-pipeline-envelope.json", "--strict"],
      "receipt_policy": "required",
      "loop_contract": null
    },
    {
      "id": "workflow-audit",
      "label": {"en": "Audit a workflow", "zh": "审计工作流"},
      "description": {"en": "Requires an operator-selected evidence file or interview transcript; use the bounded CLI audit command.", "zh": "需要操作员选择的证据文件或访谈记录；请使用有界 CLI 审计命令。"},
      "capability": "workflow-audit",
      "state": "HOST_REQUIRED",
      "effect": "READ_ONLY",
      "approval_required": false,
      "command": ["{unavailable}"],
      "timeout_seconds": 30,
      "verifier": ["{unavailable}"],
      "receipt_policy": "required",
      "loop_contract": null
    },
    {
      "id": "vault-inventory",
      "label": {"en": "Vault inventory", "zh": "Vault 清点"},
      "description": {"en": "Read governed Vault counts and debt samples when a Vault is configured.", "zh": "配置 Vault 后读取受治理的计数与债务样本。"},
      "capability": "inventory",
      "state": "HOST_REQUIRED",
      "effect": "READ_ONLY",
      "approval_required": false,
      "command": ["{python}", "tools/agentic_os.py", "vault-inventory", "--repo", "{repo_root}", "--vault", "{vault_root}"],
      "timeout_seconds": 30,
      "verifier": ["{python}", "tools/agentic_os.py", "vault-inventory", "--repo", "{repo_root}", "--vault", "{vault_root}"],
      "receipt_policy": "required",
      "loop_contract": null
    },
    {
      "id": "vault-freshness",
      "label": {"en": "Vault freshness", "zh": "Vault 新鲜度"},
      "description": {"en": "Read governed freshness findings when a Vault is configured.", "zh": "配置 Vault 后读取受治理的新鲜度发现。"},
      "capability": "freshness",
      "state": "HOST_REQUIRED",
      "effect": "READ_ONLY",
      "approval_required": false,
      "command": ["{python}", "tools/agentic_os.py", "vault-freshness", "--repo", "{repo_root}", "--vault", "{vault_root}"],
      "timeout_seconds": 30,
      "verifier": ["{python}", "tools/agentic_os.py", "vault-freshness", "--repo", "{repo_root}", "--vault", "{vault_root}"],
      "receipt_policy": "required",
      "loop_contract": null
    },
    {
      "id": "vault-prepare",
      "label": {"en": "Prepare Vault changes", "zh": "准备 Vault 变更"},
      "description": {"en": "Canonical preparation requires a host-owned workflow and is not dispatched here.", "zh": "规范准备需要宿主流程，本运行时不直接派发。"},
      "capability": "prepare",
      "state": "HOST_REQUIRED",
      "effect": "STAGED_WRITE",
      "approval_required": true,
      "command": ["{unavailable}"],
      "timeout_seconds": 30,
      "verifier": ["{unavailable}"],
      "receipt_policy": "required",
      "loop_contract": "contracts/automation-loop-contract.md"
    },
    {
      "id": "vault-commit",
      "label": {"en": "Commit Vault changes", "zh": "提交 Vault 变更"},
      "description": {"en": "Live commit remains exclusively owned by the integration flow.", "zh": "实时提交仅由集成流程所有者执行。"},
      "capability": "commit",
      "state": "UNAVAILABLE",
      "effect": "LIVE_COMMIT",
      "approval_required": true,
      "command": ["{unavailable}"],
      "timeout_seconds": 30,
      "verifier": ["{unavailable}"],
      "receipt_policy": "required",
      "loop_contract": "contracts/automation-loop-contract.md"
    },
    {
      "id": "external-publish",
      "label": {"en": "Publish externally", "zh": "外部发布"},
      "description": {"en": "External publication is disabled until a host capability and approval exist.", "zh": "外部发布在宿主能力与审批存在前保持禁用。"},
      "capability": "other",
      "state": "UNAVAILABLE",
      "effect": "EXTERNAL",
      "approval_required": true,
      "command": ["{unavailable}"],
      "timeout_seconds": 30,
      "verifier": ["{unavailable}"],
      "receipt_policy": "required",
      "loop_contract": null
    }
  ]
}
