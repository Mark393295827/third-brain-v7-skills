{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://third-brain.local/contracts/agentic-os/registry.schema.json",
  "title": "Agentic OS action registry",
  "type": "object",
  "required": ["schema_version", "actions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill_count": {"type": "integer", "minimum": 0},
    "skill_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skills": {"type": "array", "items": {"type": "object"}},
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "capability", "state", "effect", "approval_required", "command", "timeout_seconds", "verifier", "receipt_policy", "loop_contract"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "label": {"$ref": "#/$defs/locale"},
        "description": {"$ref": "#/$defs/locale"},
        "capability": {"type": "string"},
        "state": {"enum": ["LIVE", "HOST_REQUIRED", "UNAVAILABLE"]},
        "effect": {"enum": ["READ_ONLY", "STAGED_WRITE", "LIVE_COMMIT", "EXTERNAL"]},
        "approval_required": {"type": "boolean"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "verifier": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "receipt_policy": {"const": "required"},
        "loop_contract": {"type": ["string", "null"]}
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {"en": {"type": "string"}, "zh": {"type": "string"}}
    }
  }
}
