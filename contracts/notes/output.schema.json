{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "third-brain://contracts/notes/output-v8.1",
  "title": "Third Brain V8.1 Deliverable Frontmatter",
  "type": "object",
  "required": [
    "title",
    "type",
    "contract_version",
    "output_type",
    "status",
    "created",
    "updated",
    "valid_as_of",
    "freshness_status",
    "source_ids",
    "run_id"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "type": {"const": "output"},
    "contract_version": {"const": "8.1.0"},
    "output_type": {"enum": ["gmail-digest", "evaluation", "compilation", "decision-memo", "daily-loop"]},
    "status": {"enum": ["draft", "verified", "superseded", "archived"]},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "valid_as_of": {"type": "string", "format": "date"},
    "freshness_status": {"enum": ["current", "due", "stale", "snapshot", "unknown"]},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "run_id": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}

