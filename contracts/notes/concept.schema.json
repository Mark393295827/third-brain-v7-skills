{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "third-brain://contracts/notes/concept-v8.1",
  "title": "Third Brain V8.1 Gold-Standard Concept Frontmatter",
  "type": "object",
  "required": [
    "title",
    "type",
    "contract_version",
    "template_id",
    "template_version",
    "tags",
    "aliases",
    "status",
    "created",
    "updated",
    "knowledge_stage",
    "evidence_level",
    "freshness_tier",
    "valid_as_of",
    "last_verified",
    "next_review",
    "freshness_status",
    "source_ids",
    "run_id"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "type": {"const": "concept"},
    "contract_version": {"const": "8.1.0"},
    "template_id": {"const": "concept-gold-standard"},
    "template_version": {"const": "8.1.0"},
    "url": {"type": "string"},
    "author": {"type": "string"},
    "date": {"type": "string"},
    "tags": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "status": {"enum": ["seed", "growing", "evergreen", "stale", "archived"]},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "knowledge_stage": {"enum": ["captured", "stored", "cross-checked", "applied"]},
    "evidence_level": {"enum": ["single-source", "multi-source", "local-verified", "curated-map"]},
    "freshness_tier": {"enum": ["snapshot", "stable", "slow", "dynamic", "volatile", "realtime"]},
    "valid_as_of": {"type": "string", "format": "date"},
    "last_verified": {"type": "string", "format": "date"},
    "next_review": {"type": ["string", "null"], "format": "date"},
    "freshness_status": {"enum": ["current", "due", "stale", "snapshot", "unknown"]},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "run_id": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}

