{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "third-brain://contracts/notes/entity-v8.1",
  "title": "Third Brain V8.1 Entity Frontmatter",
  "type": "object",
  "required": [
    "title",
    "type",
    "contract_version",
    "entity_category",
    "tags",
    "status",
    "updated",
    "freshness_tier",
    "valid_as_of",
    "last_verified",
    "next_review",
    "freshness_status",
    "source_ids"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "type": {"const": "entity"},
    "contract_version": {"const": "8.1.0"},
    "entity_category": {"enum": ["people", "companies", "funds-investors", "products", "orgs"]},
    "tags": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "status": {"enum": ["active", "stale", "archived"]},
    "updated": {"type": "string", "format": "date"},
    "freshness_tier": {"enum": ["snapshot", "stable", "slow", "dynamic", "volatile", "realtime"]},
    "valid_as_of": {"type": "string", "format": "date"},
    "last_verified": {"type": "string", "format": "date"},
    "next_review": {"type": ["string", "null"], "format": "date"},
    "freshness_status": {"enum": ["current", "due", "stale", "snapshot", "unknown"]},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": true
}

