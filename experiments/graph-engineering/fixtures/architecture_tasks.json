  },
  "task_a": {
    "id": "independent-static-diamond",
    "description": "Three independent deterministic branches fan out and join.",
    "input": [
      3,
      1,
      4,
      1,
      5
    ],
    "branches": [
      {
        "id": "sum",
        "operation": "sum",
        "work_seconds": 0.06,
        "fail_attempts": 0
      },
      {
        "id": "unique_sorted",
        "operation": "unique_sorted",
        "work_seconds": 0.06,
        "fail_attempts": 0
      },
      {
        "id": "checksum",
        "operation": "checksum",
        "work_seconds": 0.06,
        "fail_attempts": 1
      }
    ],
    "expected": {
      "sum": 14,
      "unique_sorted": [
        1,
        3,
        4,
        5
      ],
      "checksum": "73b691f631a24926e27219e9b2e344eb2142e9b41b5daad4df3dc1af0260b373"
    },
    "transient_failure_node": "checksum"
  },
  "task_b": {
    "id": "dependency-heavy-sequence",
    "description": "Each deterministic step consumes the prior step output.",
    "initial_value": 7,
    "steps": [
      {
        "id": "add",
        "operation": "add",
        "operand": 5,
        "work_seconds": 0.015,
        "expected_output": 12,
        "depends_on": []
      },
      {
        "id": "multiply",
        "operation": "multiply",
        "operand": 3,
        "work_seconds": 0.015,
        "expected_output": 36,
        "depends_on": [
          "add"
        ]
      },
      {
        "id": "subtract",
        "operation": "subtract",
        "operand": 4,
        "work_seconds": 0.015,
        "expected_output": 32,
        "depends_on": [
          "multiply"
        ]
      },
      {
        "id": "square",
        "operation": "square",
        "work_seconds": 0.015,
        "expected_output": 1024,
        "depends_on": [
          "subtract"
        ]
      }
    ],
    "expected": 1024
  }
